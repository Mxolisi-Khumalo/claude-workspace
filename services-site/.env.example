# Copy to .env.local and fill in what you have. Every variable is optional:
# anything left unset falls back to a mock adapter (demo mode).
# Never commit real values. See docs/INTEGRATIONS.md for setup steps.

# --- AI concierge -----------------------------------------------------------
# Claude API key; unset = scripted demo assistant
ANTHROPIC_API_KEY=
# Model id for the concierge (defaults to the app's built-in choice)
ANTHROPIC_MODEL=
# Reasoning effort for chat turns: low | medium | high
CHAT_EFFORT=

# --- Site & business --------------------------------------------------------
# "true" forces every integration into mock mode even when keys are set
DEMO_MODE=
# Public base URL, e.g. https://yourdomain.co.za (payment callbacks, PDF and email links)
NEXT_PUBLIC_SITE_URL=
# Public contact address shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=
# 32+ random bytes: signs document links, mock webhooks, hashes IPs (openssl rand -base64 32)
SESSION_SECRET=
# Where lead, booking and payment notifications go (also the reply-to address)
OWNER_EMAIL=
# IANA time zone for scheduling and dates, e.g. Africa/Johannesburg
OWNER_TIMEZONE=
# Legal name printed on quotes and invoices (ECTA s43 disclosure)
BUSINESS_LEGAL_NAME=
# Physical address printed on quotes and invoices
BUSINESS_ADDRESS=
# "true" once registered for VAT with SARS (switches to tax invoices with 15% VAT)
VAT_REGISTERED=
# SARS VAT number, printed on tax invoices when VAT_REGISTERED=true
VAT_NUMBER=

# --- Storage ----------------------------------------------------------------
# Postgres connection string (Neon via Vercel Marketplace); unset = local file/memory store
DATABASE_URL=

# --- Payments ---------------------------------------------------------------
# paystack | mock; defaults to paystack when its key is set, otherwise mock
PAYMENT_PROVIDER=
# Paystack secret key (sk_test_... / sk_live_...); also verifies webhook signatures
PAYSTACK_SECRET_KEY=
# Rand per US dollar, used to charge USD quotes in ZAR (Paystack ZA settles in ZAR only)
USD_ZAR_RATE=

# --- Scheduling -------------------------------------------------------------
# calcom | mock; defaults to calcom when its key is set, otherwise mock
SCHEDULING_PROVIDER=
# Cal.com API v2 key (cal_live_...)
CALCOM_API_KEY=
# Numeric id of the "Discovery call" event type
CALCOM_EVENT_TYPE_ID=
# Secret configured on the Cal.com webhook (verifies X-Cal-Signature-256)
CALCOM_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# Resend API key (re_...); unset = emails captured at /demo/outbox
RESEND_API_KEY=
# Verified sender, e.g. "Mxolisi Khumalo <hello@mail.yourdomain.co.za>"
EMAIL_FROM=

# --- Abuse limits -----------------------------------------------------------
# Site-wide cap on verification-code emails per day (default 200; keep under your Resend quota)
VERIFICATION_EMAILS_PER_DAY=
# Site-wide cap on "handoff requested" emails to the owner per day (default 20)
HANDOFF_EMAILS_PER_DAY=

# --- Admin ------------------------------------------------------------------
# Password for /admin; unset = open in development, 404 in production
ADMIN_PASSWORD=
